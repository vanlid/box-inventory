# Copy to .env and fill in. Keep .env private (it's in .gitignore).
# The server reads this file on every platform; Docker Compose passes it to the container.

# Claude token for photo scans (from `claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=

# Backups to Google Drive: OAuth client of type "TVs and Limited Input devices" (see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backups to OneDrive: app registration with "Allow public client flows" on (see README)
MS_CLIENT_ID=
# MS_TENANT=consumers     # personal Microsoft accounts; use "common" to also allow work/school accounts

# Optional, Docker only: give the app its own HTTPS address on your tailnet (see README).
# COMPOSE_FILE=compose.yaml:compose.tailscale.yaml   # on Windows use ; instead of :
# TS_AUTHKEY=tskey-auth-...
# TS_HOSTNAME=box-inventory   # becomes https://box-inventory.<your-tailnet>.ts.net
# TS_FUNNEL=true   # also reachable from the internet, no Tailscale app needed (passkeys still required)

# Optional: local AI models through Ollama instead of Claude (see "Local models" in the README)
# SCAN_ENGINE=local        # photo scans: claude (default) or local
# ASK_ENGINE=local         # plain-language questions: claude (default) or local
# OLLAMA_URL=http://localhost:11434            # Docker on a Mac: http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5vl:7b                    # a vision model
# OLLAMA_KEEP_ALIVE=5m     # unload the model after this long without use

# BACKUP_LOCAL_DIR=/mnt/nas/box-backups:/media/usb/box-backups   # folders to back up to as well (Windows: ;)
# BACKUP_KEEP=14          # how many backups to keep in each place
# PORT=8765
# CLAUDE_MODEL=sonnet
# CLAUDE_ASK_MODEL=haiku   # model for plain-language questions
# AUTH=off                # turn off passkey sign-in (only on a network you trust)
