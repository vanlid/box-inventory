# Copy to .env and fill in. Keep .env private (it's in .gitignore).
# The server reads this file on every platform; Docker Compose passes it to the container.

# Claude token for photo scans (from `claude setup-token`)
CLAUDE_CODE_OAUTH_TOKEN=

# Backups to Google Drive: OAuth client of type "TVs and Limited Input devices" (see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backups to OneDrive: app registration with "Allow public client flows" on (see README)
MS_CLIENT_ID=
# MS_TENANT=consumers     # personal Microsoft accounts; use "common" to also allow work/school accounts

# BACKUP_KEEP=14          # how many backups to keep
# PORT=8765
# CLAUDE_MODEL=sonnet
# AUTH=off                # turn off passkey sign-in (only on a network you trust)
